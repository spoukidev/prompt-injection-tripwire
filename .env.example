# Example environment for local runs. Every value here is FAKE.
# The benchmark never needs real keys; the sandbox plants its own fake secrets.
TRIPWIRE_POLICY=config/policy.yaml
TRIPWIRE_DB=sqlite:///results/audit.db
TRIPWIRE_APPROVAL_MODE=queue
TRIPWIRE_URL=http://localhost:8080
ATTACKER_URL=http://localhost:8081
# Optional local model (not required for the benchmark)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Fake secrets used only in docs/examples
FAKE_OPENAI_API_KEY=sk-fake-TRIPWIRE0000000000000000demo
